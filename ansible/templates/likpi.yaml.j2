---
apiVersion: likpi/v1
kind: COMPUTERSYSTEM
metadata:
  name: "{{ ansible_hostname }}"
spec:
  class: "COMPUTERSYSTEM"
  status: "operational"
  attributes:
    description: "Bare-metal / VM host discovered by Ansible"
    ip_address: "{{ ansible_default_ipv4.address | default('127.0.0.1') }}"
    environment: "PROD"
    unique_identifier: "{{ ansible_product_serial | default(ansible_machine_id) }}"
    serial_number: "{{ ansible_product_serial | default('UNKNOWN-SERIAL') }}"
    cpu_count: "{{ ansible_processor_vcpus | string }}"
    category: "Hardware"
    type: "VMNaked"
    item: "N/A"
    model: "Proliant DL380 Gen11"

---
apiVersion: likpi/v1
kind: APPLICATION
metadata:
  name: "{{ app_name }}"
spec:
  class: "APPLICATION"
  status: "operational"
  attributes:
    description: "Application managed by Ansible"
    environment: "PROD"
    unique_identifier: "{{ app_id }}"
    category: "Software"
    type: "Software Application System"
    item: "Application Server Software Platforms"
    model: "N/A"
  relations:
    - target: "{{ ansible_hostname }}"
      target_class: "COMPUTERSYSTEM"
      relation_class: "RUNS_ON"
      impact: "Yes"
    - target: "{{ target_db_name | default('db-postgres-prod') }}"
      target_class: "DATABASE"
      relation_class: "DEPENDENCY"
      impact: "Yes"
