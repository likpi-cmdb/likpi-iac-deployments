apiVersion: likpi/v1
kind: COMPUTERSYSTEM
metadata:
  name: "${instance_name}"
spec:
  class: "COMPUTERSYSTEM"
  attributes:
    category: "Hardware"
    type: "Processing Unit"
    item: "Virtual Machine"
    model: "AWS EC2 t3.large"
    environment: "${environment}"
    unique_identifier: "${instance_id}"
    managed_by: "terraform"
